# Togihome Kho — Supabase. COPY sang .env (KHÔNG commit) rồi điền khoá thật.
SUPABASE_URL=https://ugebruuxkslsnbramils.supabase.co
SUPABASE_ANON_KEY=            # khoá công khai (web app dùng, RLS bảo vệ)
SUPABASE_SERVICE_ROLE_KEY=    # khoá quản trị (CHỈ script nhập liệu/migration, KHÔNG lên web)

# ── SCHEMA ──  Một dự án Supabase, tách bằng schema (sau: crm, erp). Bảng kho nằm ở "kho", KHÔNG public.
SUPABASE_DB_SCHEMA=kho
# Web app: createClient(url, key, { db: { schema: 'kho' } })  hoặc  supabase.schema('kho').from('vat_tu')
# Dashboard BẮT BUỘC: Settings -> API -> Exposed schemas -> THÊM "kho" (mặc định chỉ 'public').
